{
  "name": "atelier-workspace",
  "private": true,
  "type": "module",
  "description": "Themeable canvases for Claude Code: live, interactive views that agents write and you work from.",
  "license": "MIT",
  "workspaces": [
    "packages/themes",
    "packages/kit",
    "packages/viewer",
    "packages/daemon"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-reporter=spec \"packages/*/test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json",
    "themes": "node packages/themes/scripts/import.mjs",
    "check-themes": "node packages/themes/scripts/check.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
