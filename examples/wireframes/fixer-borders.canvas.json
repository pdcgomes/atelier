  "questions": [
    {
      "id": "panel-place",
      "title": "Where does the Border panel sit?",
      "now": "Designed after Effects, with Calibration last as in Lightroom.",
      "options": [
        "After Effects",
        "Last, after Calibration, as the last step of the pipeline"
      ],
      "lean": "After Effects: creative finishing stays together, and Lightroom users find Calibration where it always is.",
      "answer": "Last, after Calibration: the border is the last thing the photo gets."
    },
    {
      "id": "size-against",
      "title": "What is Size measured against?",
      "now": "Designed as a share of the photo's long side.",
      "options": [
        "The long side",
        "The short side"
      ],
      "lean": "The long side: a border reads the same on the portrait and landscape photos of a set.",
      "answer": "The long side, as built."
    },
    {
      "id": "mood-names",
      "title": "Do the moods that lose their frames keep their names?",
      "now": "Lost Roll, Summer '98, Home Movie, Slide Show and Contact Sheet get new versions without frames, under the same names.",
      "options": [
        "Keep the names",
        "Rename Slide Show and Contact Sheet, whose frame was their point"
      ],
      "lean": "Keep them: projected slides and a contact print still describe the look, and the matching frames are a click away in Borders.",
      "answer": "Keep the names, as built."
    },
    {
      "id": "edge-print",
      "title": "What does the film edge print say?",
      "now": "Designed with the frame number and the film look's name as Fixer names it, never a maker's name or logo.",
      "options": [
        "Frame number and the look's name",
        "Frame numbers only"
      ],
      "lean": "The look's name: it ties the frame to the film, and Fixer already uses those names for its looks.",
      "answer": "The frame number and the look's name, as built."
    }
  ]
