  "type": "module",
  "description": "Themeable canvases for Claude Code: the atelier command and its daemon.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdcgomes/atelier.git"
  },
  "homepage": "https://github.com/pdcgomes/atelier",
